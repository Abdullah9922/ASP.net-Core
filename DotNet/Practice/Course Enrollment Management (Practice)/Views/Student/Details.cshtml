@model Course_Enrollment_Management__Practice_.Models.Student

@{
ViewData["Title"] = "Student Details";
}

<div class="container mt-4">


<div class="card shadow-sm">

    <div class="card-header bg-info text-white">
        <h4 class="mb-0">Student Details</h4>
    </div>

    <div class="card-body">

        <div class="row mb-3">
            <div class="col-sm-4 fw-bold">
                Student ID
            </div>

            <div class="col-sm-8">
                @Model.Id
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-4 fw-bold">
                Name
            </div>

            <div class="col-sm-8">
                @Model.Name
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-4 fw-bold">
                Email
            </div>

            <div class="col-sm-8">
                @Model.Email
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-4 fw-bold">
                Department
            </div>

            <div class="col-sm-8">
                <span class="badge bg-primary">
                    @Model.Department
                </span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-4 fw-bold">
                CGPA
            </div>

            <div class="col-sm-8">
                @Model.CGPA
            </div>
        </div>

        <hr />

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-success">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>

        </div>

    </div>

</div>


</div>
