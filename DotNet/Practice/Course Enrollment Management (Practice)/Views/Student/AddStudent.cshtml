@model Course_Enrollment_Management__Practice_.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add New Student</h4>
        </div>

        <div class="card-body">

            <form asp-action="AddStudent" method="post">

                <!-- Id -->
                <div class="mb-3">
                    <label asp-for="Id" class="form-label">
                        Student ID
                    </label>

                    <input asp-for="Id"
                           class="form-control"
                           placeholder="Enter student ID" />

                    <span asp-validation-for="Id"
                          class="text-danger">
                    </span>
                </div>


                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Student Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter student name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>


                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>


                <!-- Department -->
                <div class="mb-3">
                    <label asp-for="Department" class="form-label">
                        Department
                    </label>

                    <select asp-for="Department"
                            class="form-select">

                        <option value="">-- Select Department --</option>
                        <option value="CSE">CSE</option>
                        <option value="EEE">EEE</option>
                        <option value="SWE">SWE</option>
                        <option value="BBA">BBA</option>

                    </select>

                    <span asp-validation-for="Department"
                          class="text-danger">
                    </span>
                </div>


                <!-- CGPA -->
                <div class="mb-3">
                    <label asp-for="CGPA" class="form-label">
                        CGPA
                    </label>

                    <input asp-for="CGPA"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="Enter CGPA" />

                    <span asp-validation-for="CGPA"
                          class="text-danger">
                    </span>
                </div>


                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Add Student
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}