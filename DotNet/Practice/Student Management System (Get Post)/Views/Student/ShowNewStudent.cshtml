@{
}



@model Student_Management_System__Get_Post_.Models.Student;

<div class="container mt-5">

    <div class="card shadow mx-auto" style="max-width: 600px;">

        <div class="card-header bg-primary text-white text-center">
            <h2>Student Details</h2>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-4 fw-bold">ID</div>
                <div class="col-8">@Model.Id</div>
            </div>

            <div class="row mb-3">
                <div class="col-4 fw-bold">Name</div>
                <div class="col-8">@Model.Name</div>
            </div>

            <div class="row mb-3">
                <div class="col-4 fw-bold">Email</div>
                <div class="col-8">@Model.Email</div>
            </div>

            <div class="row mb-3">
                <div class="col-4 fw-bold">Department</div>
                <div class="col-8">@Model.Department</div>
            </div>

            <div class="row mb-3">
                <div class="col-4 fw-bold">CGPA</div>
                <div class="col-8">@Model.Cgpa</div>
            </div>

            <div class="row">
                <div class="col-4 fw-bold">Date of Birth</div>
                <div class="col-8">@Model.DateOfBirth</div>
            </div>

        </div>

    </div>

</div>