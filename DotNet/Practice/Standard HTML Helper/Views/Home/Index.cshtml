
@model Standard_HTML_Helper.Models.Student

@{
    ViewData["Title"] = "Student Registration";
}

<div class="container mt-4">

    <h2>Student Registration Form</h2>
    <hr />

    @* =========================================================
       FORM START

       Html.BeginForm()

       Controller = Student
       Action     = AddStudent
       Method     = POST

       Form submit করলে:
       /Student/AddStudent এ POST Request যাবে
       ========================================================= *@

    @using (Html.BeginForm("AddStudent", "Home", FormMethod.Post))
    {

        @* =====================================================
           1. LABEL HELPER

           Html.LabelFor()

           Model-এর property অনুযায়ী <label> তৈরি করে।
           ===================================================== *@

        <div class="mb-3">

            @Html.LabelFor(model => model.Id, "Student ID")

            @* =================================================
               2. TEXTBOX HELPER

               Html.TextBoxFor()

               সাধারণ text input তৈরি করে।
               ================================================= *@

            @Html.TextBoxFor(
                model => model.Id,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter Student ID"
                }
            )

        </div>


        @* =====================================================
           STUDENT NAME

           TextBoxFor()
           ===================================================== *@

        <div class="mb-3">

            @Html.LabelFor(model => model.Name, "Student Name")

            @Html.TextBoxFor(
                model => model.Name,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter your name"
                }
            )

        </div>


        @* =====================================================
           EMAIL

           TextBoxFor() ব্যবহার করে email input।

           type = "email" দেওয়ার কারণে browser
           email format check করবে।
           ===================================================== *@

        <div class="mb-3">

            @Html.LabelFor(model => model.Email, "Email Address")

            @Html.TextBoxFor(
                model => model.Email,
                new
                {
                    @class = "form-control",
                    type = "email",
                    placeholder = "example@gmail.com"
                }
            )

        </div>


        @* =====================================================
           3. DROPDOWN / SELECT HELPER

           Html.DropDownListFor()

           Department select করার জন্য।

           Controller থেকে ViewBag.DepartmentList
           পাঠাতে হবে।
           ===================================================== *@

        @*@<div class="mb-3">

            @Html.LabelFor(model => model.Department, "Department")

            @Html.DropDownListFor(
                model => model.Department,
                ViewBag.DepartmentList as IEnumerable<SelectListItem>,
                "-- Select Department --",
                new
                {
                    @class = "form-control"
                }
            )

        </div>*@


        @* =====================================================
           4. PASSWORD HELPER

           Html.PasswordFor()

           Password input তৈরি করে।
           Typed text hide থাকবে।

           Model-এ Password property থাকতে হবে।
           ===================================================== *@

        <div class="mb-3">

            @Html.LabelFor(model => model.Password, "Password")

            @Html.PasswordFor(
                model => model.Password,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter password"
                }
            )

        </div>


        @* =====================================================
           5. NUMBER INPUT

           TextBoxFor() দিয়েও number input করা যায়।

           type = number
           min = 0
           max = 4
           step = 0.01
           ===================================================== *@

        <div class="mb-3">

            @Html.LabelFor(model => model.Cgpa, "CGPA")

            @Html.TextBoxFor(
                model => model.Cgpa,
                new
                {
                    @class = "form-control",
                    type = "number",
                    step = "0.01",
                    min = "0",
                    max = "4",
                    placeholder = "Enter CGPA"
                }
            )

        </div>


        @* =====================================================
           6. DATE INPUT

           DateOfBirth এর জন্য।

           type = date
           ===================================================== *@

        <div class="mb-3">

            @Html.LabelFor(model => model.DateOfBirth, "Date of Birth")

            @Html.TextBoxFor(
                model => model.DateOfBirth,
                "{0:yyyy-MM-dd}",
                new
                {
                    @class = "form-control",
                    type = "date"
                }
            )

        </div>


        @* =====================================================
           7. RADIO BUTTON

           Html.RadioButtonFor()

           একই property-এর জন্য multiple radio button।

           এখানে:
           Male   -> value = Male
           Female -> value = Female
           Other  -> value = Other
           ===================================================== *@

        <div class="mb-3">

            <label>Gender</label>

            <br />

            @Html.RadioButtonFor(
                model => model.Gender,
                "Male"
            )
            <label>Male</label>


            @Html.RadioButtonFor(
                model => model.Gender,
                "Female"
            )
            <label>Female</label>


            @Html.RadioButtonFor(
                model => model.Gender,
                "Other"
            )
            <label>Other</label>

        </div>


        @* =====================================================
           8. CHECKBOX

           Html.CheckBoxFor()

           Boolean property-এর জন্য ব্যবহার করা হয়।

           Example:
           public bool IsActive { get; set; }
           ===================================================== *@

        <div class="mb-3">

            @Html.CheckBoxFor(
                model => model.IsActive
            )

            <label>Active Student</label>

        </div>


        @* =====================================================
           9. TEXTAREA

           Html.TextAreaFor()

           বড় text লেখার জন্য।

           Example:
           Address
           Description
           Comment
           ===================================================== *@

        <div class="mb-3">

            @Html.LabelFor(model => model.Address, "Address")

            @Html.TextAreaFor(
                model => model.Address,
                new
                {
                    @class = "form-control",
                    rows = "4",
                    placeholder = "Enter your address"
                }
            )

        </div>


        @* =====================================================
           10. HIDDEN INPUT

           Html.HiddenFor()

           User দেখতে পাবে না।

           কিন্তু form submit করলে value server-এ যাবে।

           ===================================================== *@

        @Html.HiddenFor(model => model.Id)


        @* =====================================================
           11. SUBMIT BUTTON

           Form-এর ভিতরের submit button।

           Click করলে form-এর data Controller-এ যাবে।
           ===================================================== *@

        <div class="mt-3">

            <button type="submit" class="btn btn-primary">
                Register Student
            </button>

        </div>

    }

</div>
