@model Standard_HTML_Helper.Models.Student

@{
    ViewData["Title"] = "Student Information";
}

<div class="container mt-5">

    @* ================================
       PAGE TITLE
       ================================ *@

    <div class="text-center mb-4">
        <h1>Student Information</h1>
        <p class="text-muted">
            Complete information of the student
        </p>
    </div>


    @* ================================
       STUDENT INFORMATION CARD
       ================================ *@

    <div class="card shadow mx-auto" style="max-width: 700px;">

        @* Card Header *@

        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0">Student Details</h4>
        </div>


        @* Card Body *@

        <div class="card-body">


            @* ================================
               STUDENT ID
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Student ID
                </div>

                <div class="col-sm-8">
                    @Model.Id
                </div>

            </div>


            <hr />


            @* ================================
               NAME
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Name
                </div>

                <div class="col-sm-8">
                    @Model.Name
                </div>

            </div>


            <hr />


            @* ================================
               EMAIL
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Email
                </div>

                <div class="col-sm-8">
                    @Model.Email
                </div>

            </div>


            @*<hr />


             ================================
               DEPARTMENT
               ================================ 

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Department
                </div>

                <div class="col-sm-8">
                    <span class="badge bg-info text-dark">
                        @Model.Department
                    </span>
                </div>

            </div>*@


            <hr />


            @* ================================
               CGPA
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    CGPA
                </div>

                <div class="col-sm-8">
                    @Model.Cgpa
                </div>

            </div>


            <hr />


            @* ================================
               DATE OF BIRTH
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Date of Birth
                </div>

                <div class="col-sm-8">
                    @Model.DateOfBirth.ToString("dd MMMM yyyy")
                </div>

            </div>


            <hr />


            @* ================================
               GENDER
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Gender
                </div>

                <div class="col-sm-8">
                    @Model.Gender
                </div>

            </div>


            <hr />


            @* ================================
               ACTIVE STATUS
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Status
                </div>

                <div class="col-sm-8">

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactive
                        </span>
                    }

                </div>

            </div>


            <hr />


            @* ================================
               ADDRESS
               ================================ *@

            <div class="row mb-3">

                <div class="col-sm-4 fw-bold">
                    Address
                </div>

                <div class="col-sm-8">
                    @Model.Address
                </div>

            </div>


        </div>


        @* ================================
           CARD FOOTER
           ================================ *@

        <div class="card-footer text-center">

            <a asp-controller="Student"
               asp-action="AddStudent"
               class="btn btn-primary">

                Add Another Student

            </a>

            <a asp-controller="Student"
               asp-action="AllStudent"
               class="btn btn-secondary">

                View All Students

            </a>

        </div>

    </div>

</div>

